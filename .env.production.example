# Variáveis de produção: copie para .env.production (fora do Git) e troque os segredos.
PORT=3333
NODE_ENV=production
API_URL=https://api.localhost

# Database (o serviço db do compose.prod.yaml)
DB_TYPE=postgres
DB_HOST=db
DB_PORT=5432
DB_SCHEMA=public
DB_NAME=apivendas
DB_USER=apivendas
DB_PASS=troque-esta-senha
JWT_SECRET=troque-este-segredo
JWT_EXPIRES_IN=86400

# Redis (o serviço cache)
REDIS_HOST=cache
REDIS_PORT=6379
REDIS_USER=
REDIS_PASS=

# E-mail pelo Amazon SES (aqui, o LocalStack do compose)
MAIL_DRIVER=ses
AWS_SES_REGION=us-east-1
AWS_SES_ENDPOINT=http://localstack:4566
AWS_SES_ACCESS_KEY_ID=test
AWS_SES_SECRET_ACCESS_KEY=test

# Upload com Cloudflare/Amazon S3
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_URL=
BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
