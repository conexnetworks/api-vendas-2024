PORT=3333
NODE_ENV=development
API_URL=http://localhost:3333

# Database
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_SCHEMA=public
DB_NAME=postgres
DB_USER=postgres
DB_PASS=postgres
JWT_SECRET=my_secret
JWT_EXPIRES_IN=86400

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=
REDIS_PASS=

# E-mail: json (só no log), smtp (Mailpit) ou ses (Amazon SES)
MAIL_DRIVER=smtp

# E-mail (Mailpit em desenvolvimento)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# E-mail com Amazon SES (no LocalStack: endpoint http://localhost:4566 e chaves test)
AWS_SES_REGION=us-east-1
AWS_SES_ENDPOINT=
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=

# Upload com Cloudflare/Amazon S3
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_URL=
BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
